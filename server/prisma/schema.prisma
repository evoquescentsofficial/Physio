generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite does not support native enums; these fields use validated string values.
// Role: ADMIN | DOCTOR | RECEPTIONIST
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("RECEPTIONIST")
  createdAt DateTime @default(now())
}

model Patient {
  id               String    @id @default(cuid())
  name             String
  phone            String
  email            String?
  address          String?
  dob              DateTime?
  gender           String?
  occupation       String?
  referredBy       String?
  bloodGroup       String?
  emergencyContact String?
  notes            String?
  photoUrl         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  diagnoses Diagnosis[]
  packages  TreatmentPackage[]
  visits    Visit[]
  payments  Payment[]

  @@index([phone])
  @@index([name])
}

model Diagnosis {
  id            String   @id @default(cuid())
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date          DateTime @default(now())
  title         String
  details       String?
  treatmentPlan String?
  remarks       String?
  // Free text kept for records written before the clinic had a doctors list, and for
  // referrals from outside the clinic. New entries link to a Doctor instead.
  doctorName    String?
  doctorId      String?
  doctor        Doctor?  @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  // Where the problem is, and which side — structured so the clinic can see what it treats
  // most rather than having it buried in prose.
  bodyRegion    String?
  side          String?
  // Baseline pain out of 10 at assessment, the number progress is measured against.
  painScore     Int?
  createdAt     DateTime @default(now())

  packages TreatmentPackage[]
  visits   Visit[]

  @@index([patientId])
}

// status: ACTIVE | COMPLETED | CANCELLED
model TreatmentPackage {
  id            String     @id @default(cuid())
  patientId     String
  patient       Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  diagnosisId   String?
  diagnosis     Diagnosis? @relation(fields: [diagnosisId], references: [id])
  title         String
  totalSessions Int
  feePerSession Float
  totalFee      Float
  startDate     DateTime   @default(now())
  status        String     @default("ACTIVE")
  notes         String?
  createdAt     DateTime   @default(now())

  visits       Visit[]
  installments Installment[]
  payments     Payment[]
}

// status: PENDING | PAID (OVERDUE is derived from dueDate, never stored)
model Installment {
  id        String           @id @default(cuid())
  packageId String
  package   TreatmentPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  amount    Float
  dueDate   DateTime
  paidDate  DateTime?
  status    String           @default("PENDING")
  notes     String?
  createdAt DateTime         @default(now())

  // The Payment created when this installment was marked paid, so the two can never
  // disagree: clearing the payment clears the installment and vice versa.
  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([dueDate])
  @@index([packageId])
}

// type: INITIAL_CONSULT | SESSION | FOLLOWUP
// attendance: SCHEDULED | PRESENT | ABSENT | CARRIED_FORWARD | CANCELLED
model Visit {
  id             String            @id @default(cuid())
  patientId      String
  patient        Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  packageId      String?
  package        TreatmentPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  diagnosisId    String?
  diagnosis      Diagnosis?        @relation(fields: [diagnosisId], references: [id])
  doctorId       String?
  doctor         Doctor?           @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  sessionNumber  Int?
  scheduledDate  DateTime
  completedDate  DateTime?
  type           String            @default("SESSION")
  fee            Float             @default(0)
  feeCollected   Boolean           @default(false)
  attendance     String            @default("SCHEDULED")
  carriedForward Boolean           @default(false)
  carriedFromId  String?
  remarks        String?
  treatmentNotes String?
  createdAt      DateTime          @default(now())

  payments Payment[]

  @@index([scheduledDate])
  @@index([patientId])
  @@index([doctorId])
  @@index([packageId])
}

// type: ADVANCE | SESSION_FEE | INSTALLMENT | VISIT_FEE | REFUND
// method: CASH | CARD | UPI | BANK_TRANSFER | OTHER
model Payment {
  id        String            @id @default(cuid())
  patientId String
  patient   Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  packageId String?
  package   TreatmentPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  visitId   String?
  visit     Visit?            @relation(fields: [visitId], references: [id], onDelete: SetNull)
  amount    Float
  // What was taken off the standard fee, for a family rate, a concession or a waived
  // visit. `amount` is always what was actually collected; this records what was given up.
  discount  Float             @default(0)
  type      String
  method    String            @default("CASH")
  date      DateTime          @default(now())
  notes     String?
  createdAt DateTime          @default(now())

  installment Installment?

  @@index([patientId, date])
  @@index([date])
}

// Employee physiotherapists / consultants the clinic owner manages.
// Consultation fee is optional: many clinics charge per package, not per doctor.
model Doctor {
  id              String    @id @default(cuid())
  name            String
  specialization  String?
  qualification   String?
  phone           String?
  email           String?
  consultationFee Float?
  joinedDate      DateTime?
  active          Boolean   @default(true)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  visits    Visit[]
  diagnoses Diagnosis[]
}

// Single-row table (id is always "clinic") holding clinic-wide defaults.
model ClinicSettings {
  id                String   @id @default("clinic")
  clinicName        String   @default("Physio Fitness Clinic")
  phone             String?
  address           String?
  checkupFee        Float    @default(1000)
  defaultSessionFee Float    @default(1500)
  updatedAt         DateTime @updatedAt
}

// category: SALARY | RENT | UTILITIES | EQUIPMENT | MARKETING | MAINTENANCE | OTHER
model Expense {
  id        String   @id @default(cuid())
  category  String
  title     String
  amount    Float
  date      DateTime @default(now())
  paidTo    String?
  notes     String?
  createdAt DateTime @default(now())
}
